{
  "name": "sugarsocietysc",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n docker,api,web -c blue,green,magenta \"npm:dev:docker\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:docker": "docker compose up",
    "dev:api": "npm run dev --workspace=@sugarsocietysc/api",
    "dev:web": "npm run start --workspace=@sugarsocietysc/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "migrate": "npm run migrate --workspace=@sugarsocietysc/api",
    "cdk": "npm run cdk --workspace=@sugarsocietysc/infra"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.5"
  }
}
