# Copy to .env.local and fill in as needed — defaults below match docker-compose.yml.

# packages/api
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sugarsocietysc
PORT=3001
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
SMS_PROVIDER=sns
UPLOADS_BUCKET_NAME=local-uploads
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
GUEST_PII_RETENTION_DAYS=60
COGNITO_ENDPOINT=http://localhost:9229
# Run `npm run seed:cognito --workspace=@sugarsocietysc/api` once cognito-local is up, then paste its
# printed values over these placeholders. Note: cognito-local always issues tokens with host "0.0.0.0"
# in the `iss` claim (a known quirk), so COGNITO_ISSUER_URL must use 0.0.0.0, not localhost.
COGNITO_USER_POOL_ID=local_placeholder
COGNITO_CLIENT_ID=local_placeholder
COGNITO_ISSUER_URL=http://0.0.0.0:9229/local_placeholder
# To verify real Google federation end-to-end, swap these three for the deployed dev pool's values
# (packages/infra Auth stack outputs: UserPoolId, UserPoolClientId, and issuer
# https://cognito-idp.<region>.amazonaws.com/<UserPoolId>) while still running the API/DB locally.


# packages/web
REACT_APP_API_BASE_URL=http://localhost:3001
REACT_APP_COGNITO_ENDPOINT=http://localhost:9229
REACT_APP_COGNITO_USER_POOL_ID=local_placeholder
REACT_APP_COGNITO_CLIENT_ID=local_placeholder
# Google sign-in is AWS-only (cognito-local has no Hosted UI). To test it locally, point these three
# (plus COGNITO_USER_POOL_ID/CLIENT_ID above and api's COGNITO_ISSUER_URL/CLIENT_ID below) at the real
# deployed dev User Pool instead of cognito-local — see packages/infra Auth stack outputs.
REACT_APP_COGNITO_HOSTED_UI_DOMAIN=https://sugarsocietysc-auth-dev.auth.us-east-1.amazoncognito.com
REACT_APP_COGNITO_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
